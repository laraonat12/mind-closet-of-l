---
import { withBase } from '../lib/url';
// A little cake shaped like a city skyline: as you scroll past the hero,
// the cherry drifts down and lands (with a soft bounce) on the top tier.
---

<section class="cake-hero" id="cake-hero">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <span class="pill">İstanbul · Moda · Ekran</span>
      <h1>
        Mind Closet <em>of</em> L
      </h1>
      <p class="lede">
        Büyük şehirde gündelik hayatın, dolabımın ve ekranda izlediğim
        hikayelerin kesiştiği yer. Bazen bir sokak, bazen bir kombin, bazen
        bir dizi finali — hepsi burada bir araya geliyor.
      </p>
      <a class="btn" href={withBase('/yazilar')}>Yazılara göz at</a>
    </div>

    <div class="hero-art" aria-hidden="true">
      <svg
        id="cake-svg"
        viewBox="0 0 360 420"
        xmlns="http://www.w3.org/2000/svg"
      >
        <!-- soft ground shadow -->
        <ellipse cx="180" cy="392" rx="120" ry="14" fill="var(--color-pink-soft)" />

        <!-- tier 3 (base / widest, "downtown" building) -->
        <g class="tier tier-3">
          <rect x="55" y="270" width="250" height="110" rx="14" fill="var(--color-pink)" />
          <rect x="55" y="270" width="250" height="14" rx="7" fill="#fff" opacity="0.7" />
          <circle cx="90" cy="315" r="6" fill="#fff" opacity="0.85" />
          <circle cx="130" cy="315" r="6" fill="#fff" opacity="0.85" />
          <circle cx="170" cy="315" r="6" fill="#fff" opacity="0.85" />
          <circle cx="210" cy="315" r="6" fill="#fff" opacity="0.85" />
          <circle cx="250" cy="315" r="6" fill="#fff" opacity="0.85" />
          <circle cx="90" cy="345" r="6" fill="#fff" opacity="0.85" />
          <circle cx="130" cy="345" r="6" fill="#fff" opacity="0.85" />
          <circle cx="170" cy="345" r="6" fill="#fff" opacity="0.85" />
          <circle cx="210" cy="345" r="6" fill="#fff" opacity="0.85" />
          <circle cx="250" cy="345" r="6" fill="#fff" opacity="0.85" />
        </g>

        <!-- tier 2 -->
        <g class="tier tier-2">
          <rect x="95" y="170" width="170" height="100" rx="12" fill="#fff" />
          <rect x="95" y="170" width="170" height="12" rx="6" fill="var(--color-pink)" />
          <rect x="112" y="196" width="14" height="60" rx="4" fill="var(--color-pink-soft)" />
          <rect x="144" y="196" width="14" height="60" rx="4" fill="var(--color-pink-soft)" />
          <rect x="176" y="196" width="14" height="60" rx="4" fill="var(--color-pink-soft)" />
          <rect x="208" y="196" width="14" height="60" rx="4" fill="var(--color-pink-soft)" />
          <rect x="234" y="196" width="14" height="60" rx="4" fill="var(--color-pink-soft)" />
        </g>

        <!-- tier 1 (top) -->
        <g class="tier tier-1">
          <rect x="130" y="95" width="100" height="80" rx="10" fill="var(--color-coffee)" />
          <rect x="130" y="95" width="100" height="10" rx="5" fill="var(--color-pink)" />
          <circle cx="150" cy="130" r="5" fill="var(--color-pink-soft)" />
          <circle cx="180" cy="130" r="5" fill="var(--color-pink-soft)" />
          <circle cx="210" cy="130" r="5" fill="var(--color-pink-soft)" />
          <circle cx="150" cy="150" r="5" fill="var(--color-pink-soft)" />
          <circle cx="180" cy="150" r="5" fill="var(--color-pink-soft)" />
          <circle cx="210" cy="150" r="5" fill="var(--color-pink-soft)" />
        </g>

        <!-- candle -->
        <rect x="176" y="72" width="8" height="26" rx="3" fill="var(--color-cherry)" />
        <path
          d="M180 58 C 176 66, 184 68, 180 72 C 176 68, 184 66, 180 58 Z"
          fill="#f0a63b"
        />

        <!-- cherry: starts up + to the side, lands on the top tier on scroll -->
        <g id="cherry" class="cherry">
          <path d="M0 14 C -2 2, 8 -4, 12 6" stroke="#6b8f5a" stroke-width="3" fill="none" stroke-linecap="round" />
          <circle cx="0" cy="18" r="13" fill="var(--color-cherry)" />
          <circle cx="-5" cy="13" r="4" fill="#ffffff" opacity="0.35" />
        </g>
      </svg>
    </div>
  </div>
</section>

<style>
  .cake-hero {
    padding: 56px 0 40px;
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 40px;
    align-items: center;
  }
  .hero-copy h1 {
    font-size: clamp(2.4rem, 5vw, 3.4rem);
    margin: 14px 0 18px;
  }
  .hero-copy h1 em {
    color: var(--color-cherry);
    font-style: italic;
  }
  .lede {
    max-width: 42ch;
    color: var(--color-coffee-soft);
    font-size: 1.08rem;
  }
  .hero-art {
    position: relative;
  }
  #cake-svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .tier {
    transform-box: fill-box;
    transform-origin: center bottom;
    transition: transform 0.15s ease-out;
  }
  /* tiny settle/squash on the top tier once the cherry lands */
  .tier-1 {
    transform: scaleY(calc(1 - var(--land, 0) * 0.05));
  }

  #cherry {
    transform-box: fill-box;
    transform-origin: center;
    /* invisible until you start scrolling, then pops in out of nowhere and
       drifts down (--drop) to land on the top tier */
    opacity: var(--appear, 0);
    transform: translate(140px, 40px) translateY(calc(-1 * (1 - var(--drop, 0)) * 90px))
      rotate(calc((1 - var(--drop, 0)) * -18deg))
      scale(calc(0.5 + var(--appear, 0) * 0.5));
  }

  @media (max-width: 780px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-art {
      order: -1;
      max-width: 280px;
      margin: 0 auto;
    }
  }
</style>

<script>
  function easeOutBack(x: number): number {
    const c1 = 1.4;
    const c3 = c1 + 1;
    return 1 + c3 * Math.pow(x - 1, 3) + c1 * Math.pow(x - 1, 2);
  }

  const hero = document.getElementById('cake-hero');
  const svg = document.getElementById('cake-svg') as HTMLElement | null;

  function updateDrop() {
    if (!hero || !svg) return;
    const rect = hero.getBoundingClientRect();
    const viewportH = window.innerHeight;
    // progress: 0 when hero top is at viewport top, 1 once scrolled ~60% of hero height
    const raw = -rect.top / (rect.height * 0.6);
    const progress = Math.min(Math.max(raw, 0), 1);
    const eased = easeOutBack(progress);
    // pops into view during the first third of the scroll, then drifts/lands
    const appear = Math.min(progress / 0.3, 1);
    svg.style.setProperty('--drop', String(eased));
    svg.style.setProperty('--land', String(progress));
    svg.style.setProperty('--appear', String(appear));
  }

  updateDrop();
  window.addEventListener('scroll', updateDrop, { passive: true });
  window.addEventListener('resize', updateDrop);
</script>
