---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap bar">
    <p>&copy; {year} Mind Closet of L</p>
    <p class="tag">İstanbul'dan, kahve ve biraz pudra şekeriyle. 🍒</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 80px;
    padding: 32px 0 48px;
    border-top: 1px solid var(--color-border);
  }
  .bar {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--color-coffee-soft);
  }
  .tag {
    font-style: italic;
  }
</style>
